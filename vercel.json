{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "desktop": {
      "root": "apps/desktop",
      "framework": "vite"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "server": {
      "root": "packages/sdk/server",
      "runtime": "node"
    },
    "sdk": {
      "root": "python/sdk",
      "runtime": "python"
    },
    "sdk-runtime": {
      "root": "python/sdk-runtime",
      "runtime": "python"
    },
    "website": {
      "root": "website",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
